# Development-only values. Copy this file to .env before starting Docker.
# Do not reuse these passwords in a server deployment.
COMPOSE_PROJECT_NAME=ai-hazard-recognition
NEXT_PUBLIC_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://backend:8010
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public demo defaults: no cloud API or model weight is required.
DETECTOR_PROVIDER=mock
VLM_PROVIDER=mock
HAZARD_DECISION_MODE=direct

# Optional local fine-tuned model. The path is inside the backend container.
# DETECTOR_PROVIDER=yolo
# DETECTOR_MODEL_PATH=/app/models/your-model.pt
# DETECTOR_DEVICE=auto

# Optional external algorithm service. Never commit its token.
# ALGORITHM_ADAPTER_PROVIDER=http
# ALGORITHM_ADAPTER_SCOPE=whole
# ALGORITHM_ADAPTER_URL=http://model-service:8080
# ALGORITHM_ADAPTER_TOKEN=

# Optional Qwen-compatible visual model. Keep the key only in local .env or a secret manager.
# VLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3-vl-plus

# Stream-control shared secret. REQUIRED whenever the backend is reachable on a
# non-loopback interface (the backend refuses to start without it in that case):
# the gateway in front of the backend must inject it into forwarded requests as
# the X-Control-Key header. In the bundled Docker Compose setup the frontend
# proxy injects it automatically from this value. Keep the loopback-only
# development value out of production.
CONTROL_API_KEY=local-development-control-key-change-before-production
MEDIAMTX_CONTROL_URL=http://mediamtx:9997
MEDIAMTX_API_USER=mediamtx-api
MEDIAMTX_API_PASSWORD=development-api-password-change-me
MEDIAMTX_READ_USER=mediamtx-algorithm
MEDIAMTX_READ_PASSWORD=development-read-password-change-me
MEDIAMTX_PLAYBACK_USER=mediamtx-browser
MEDIAMTX_PLAYBACK_PASSWORD=development-playback-password-change-me
MEDIAMTX_PUBLISH_USER=mediamtx-publisher
MEDIAMTX_PUBLISH_PASSWORD=development-publish-password-change-me
MEDIAMTX_RTSP_BASE=rtsp://mediamtx:8554
MEDIAMTX_WEBRTC_BASE=http://localhost:8889
MEDIAMTX_HLS_BASE=http://localhost:8888
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=localhost,127.0.0.1

# Optional notification and Hikvision bridge settings; keep blank for the demo.
EMAIL_SMTP_HOST=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
HIKVISION_BRIDGE_URL=
HIKVISION_BRIDGE_TOKEN=

# 国内网络构建加速（可选）：Debian apt 镜像与 PyPI 镜像，海外留空即可。
APT_MIRROR=
PIP_INDEX_URL=
